<?php

/**
 * @file
 * Legacy hook stubs for the Cybersource REST / Microform module.
 *
 * Hook implementations live as class methods in
 * \Drupal\cybersource_rest\Hook\CybersourceRestHooks (see
 * https://www.drupal.org/node/3442349). The procedural stub below only runs
 * on Drupal < 11.1; on 11.1+ the #[LegacyHook] attribute makes core skip it
 * so the hook runs exactly once.
 */

declare(strict_types=1);

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\cybersource_rest\Hook\CybersourceRestHooks;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function cybersource_rest_help(string $route_name, RouteMatchInterface $route_match): string {
  return \Drupal::classResolver(CybersourceRestHooks::class)->help($route_name, $route_match);
}
