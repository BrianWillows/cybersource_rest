<?php

/**
 * @file
 * Install-time guidance and runtime health checks for the Cybersource REST module.
 *
 * This module deliberately does NOT create payment gateways, grant permissions,
 * or otherwise mutate site configuration on install — a contributed module
 * should not silently change a site's business config or roles. Setup is
 * performed by the site builder; see README.md.
 */

declare(strict_types=1);

use Drupal\commerce_payment\Entity\PaymentGateway;

/**
 * Credentials file URI.
 *
 * A literal (not the CredentialProvider constant) because hook_requirements()
 * can run before the module's own classes are autoloadable.
 */
const CYBERSOURCE_REST_CREDENTIALS_URI = 'private://keys/cybersource_rest.yml';

/**
 * Implements hook_install().
 */
function cybersource_rest_install(): void {
  \Drupal::messenger()->addStatus(t('Cybersource REST (Microform) installed. To finish: add a "Cybersource (REST Microform)" payment gateway under Commerce » Configuration » Payment gateways, place your REST API credentials in %uri (see README), and enforce a Content-Security-Policy on checkout.', [
    '%uri' => CYBERSOURCE_REST_CREDENTIALS_URI,
  ]));
}

/**
 * Implements hook_requirements().
 *
 * Runtime-only (never blocks install or config import). Surfaces the setup that
 * silently breaks payments: the private filesystem, the credentials file and
 * test mode.
 *
 * @return array<string, array<string, mixed>>
 *   The requirements, keyed by machine name.
 */
function cybersource_rest_requirements(string $phase): array {
  if ($phase !== 'runtime') {
    return [];
  }

  $requirements = [];

  $private = \Drupal::service('file_system')->realpath('private://');
  if (!$private) {
    $requirements['cybersource_rest_private'] = [
      'title' => t('Cybersource REST: private filesystem'),
      'value' => t('Not configured'),
      'description' => t('Set $settings["file_private_path"] to a directory OUTSIDE the web root. Cybersource credentials are read from %uri.', ['%uri' => CYBERSOURCE_REST_CREDENTIALS_URI]),
      'severity' => REQUIREMENT_ERROR,
    ];
    return $requirements;
  }

  try {
    /** @var \Drupal\cybersource_rest\CredentialProvider $creds */
    $creds = \Drupal::service('cybersource_rest.credentials');
    $creds->load();
    $modes = $creds->configuredModes();
    if (!$modes) {
      $requirements['cybersource_rest_creds'] = [
        'title' => t('Cybersource REST: credentials'),
        'value' => t('No complete profiles configured'),
        'description' => t('Copy cybersource_rest.credentials.example.yml to %uri and fill in a test and/or live profile. Payments cannot be taken until then.', ['%uri' => CYBERSOURCE_REST_CREDENTIALS_URI]),
        'severity' => REQUIREMENT_WARNING,
      ];
    }
    else {
      $requirements['cybersource_rest_creds'] = [
        'title' => t('Cybersource REST: credentials'),
        'value' => t('Loaded from %uri (modes: @modes)', [
          '%uri' => CYBERSOURCE_REST_CREDENTIALS_URI,
          '@modes' => implode(', ', $modes),
        ]),
        'severity' => REQUIREMENT_OK,
      ];
    }
  }
  catch (\Throwable $e) {
    $requirements['cybersource_rest_creds'] = [
      'title' => t('Cybersource REST: credentials'),
      'value' => t('Missing or invalid — payments cannot be taken'),
      'description' => cybersource_rest_credentials_error_message($e->getMessage()),
      'severity' => REQUIREMENT_ERROR,
    ];
  }

  // Warn while any Cybersource REST gateway is in test mode.
  $test = [];
  foreach (PaymentGateway::loadMultiple() as $gateway) {
    if ($gateway->getPluginId() === 'cybersource_rest' && $gateway->getPlugin()->getMode() === 'test') {
      $test[] = $gateway->label();
    }
  }
  if ($test) {
    $requirements['cybersource_rest_test_mode'] = [
      'title' => t('Cybersource REST: mode'),
      'value' => t('TEST mode: @list', ['@list' => implode(', ', $test)]),
      'description' => t('Payments are not real in test mode. Switch to live before taking real orders.'),
      'severity' => REQUIREMENT_WARNING,
    ];
  }

  // Optional key-expiry monitoring. If the operator records a key_expiry for a
  // REST API key (e.g. an organisation that rotates keys on a schedule), warn a
  // month out and error once the recorded date has passed.
  try {
    $expiries = \Drupal::service('cybersource_rest.credentials')->keyExpiries();
  }
  catch (\Throwable $e) {
    $expiries = [];
  }
  if ($expiries) {
    $today = new \DateTimeImmutable('today');
    $soon = $today->modify('+1 month');
    $expired = [];
    $expiring = [];
    foreach ($expiries as $label => $date) {
      $when = \DateTimeImmutable::createFromFormat('!Y-m-d', $date);
      if (!$when) {
        // Unparseable date: tell the operator rather than silently ignore it.
        $expiring[] = t('@label (unreadable date "@date" — use YYYY-MM-DD)', ['@label' => $label, '@date' => $date]);
        continue;
      }
      if ($when < $today) {
        $expired[] = sprintf('%s (%s)', $label, $date);
      }
      elseif ($when < $soon) {
        $expiring[] = sprintf('%s (%s)', $label, $date);
      }
    }
    if ($expired) {
      $requirements['cybersource_rest_key_expired'] = [
        'title' => t('Cybersource REST: key expiry'),
        'value' => t('Expired: @list', ['@list' => implode(', ', $expired)]),
        'description' => t('These Cybersource REST API keys are past their recorded expiry: @list. Generate a new key in the Business Center (Payment Configuration » Key Management » REST APIs), update %uri, and refresh its key_expiry.', [
          '@list' => implode(', ', $expired),
          '%uri' => CYBERSOURCE_REST_CREDENTIALS_URI,
        ]),
        'severity' => REQUIREMENT_ERROR,
      ];
    }
    if ($expiring) {
      $requirements['cybersource_rest_key_expiring'] = [
        'title' => t('Cybersource REST: key expiry'),
        'value' => t('Expiring soon: @list', ['@list' => implode(', ', $expiring)]),
        'description' => t('These Cybersource REST API keys reach their recorded expiry within a month: @list. Generate a replacement key in the Business Center (Payment Configuration » Key Management » REST APIs) and update %uri before then.', [
          '@list' => implode(', ', $expiring),
          '%uri' => CYBERSOURCE_REST_CREDENTIALS_URI,
        ]),
        'severity' => REQUIREMENT_WARNING,
      ];
    }
  }

  // SOP/Microform renders card fields in the merchant page; a checkout CSP is an
  // operator responsibility we cannot verify.
  $requirements['cybersource_rest_csp'] = [
    'title' => t('Cybersource REST: checkout CSP'),
    'value' => t('Operator responsibility'),
    'description' => t('Card fields are embedded (as Cybersource-hosted iframes) in your checkout page, so a Content-Security-Policy is required for PCI DSS. Confirm your PCI scope with your acquirer or QSA; see README.'),
    'severity' => REQUIREMENT_INFO,
  ];

  return $requirements;
}
