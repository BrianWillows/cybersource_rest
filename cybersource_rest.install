<?php

/**
 * @file
 * Install-time guidance and legacy requirements stub for Cybersource REST.
 *
 * This module deliberately does NOT create payment gateways, grant permissions,
 * or otherwise mutate site configuration on install — a contributed module
 * should not silently change a site's business config or roles. Setup is
 * performed by the site builder; see README.md.
 *
 * The runtime requirements themselves live in
 * \Drupal\cybersource_rest\CredentialsStatus::runtimeRequirements(), invoked on
 * Drupal 11.3+ through hook_runtime_requirements() in
 * \Drupal\cybersource_rest\Hook\CybersourceRestHooks. The
 * #[LegacyRequirementsHook] stub below only runs on older cores.
 */

declare(strict_types=1);

use Drupal\Core\Hook\Attribute\LegacyRequirementsHook;

/**
 * Implements hook_install().
 *
 * Only points the site builder at the manual setup steps; no config is created.
 */
function cybersource_rest_install(): void {
  // The settings key is a literal (not the CredentialProvider constant)
  // because hook_install() can run before the module's own classes are
  // autoloadable.
  \Drupal::messenger()->addStatus(t('Cybersource REST (Microform) installed. To finish: add a "Cybersource (REST Microform)" payment gateway under Commerce » Configuration » Payment gateways, provide your REST API credentials via %setting in settings.php (see README), and enforce a Content-Security-Policy on checkout.', [
    '%setting' => "\$settings['cybersource_rest.credentials_file']",
  ]));
}

/**
 * Implements hook_requirements().
 *
 * Legacy stub for Drupal <= 11.2 (the attribute makes 11.3+ skip it, so the
 * requirements are never reported twice). Runtime-only: never blocks install
 * or config import.
 *
 * @return array<string, array<string, mixed>>
 *   The requirements, keyed by machine name.
 */
#[LegacyRequirementsHook]
function cybersource_rest_requirements(string $phase): array {
  if ($phase !== 'runtime') {
    return [];
  }
  // Integer severities intentionally match the REQUIREMENT_* constants — see
  // CredentialsStatus::SEVERITY_*.
  return \Drupal::service('cybersource_rest.credentials_status')->runtimeRequirements();
}
